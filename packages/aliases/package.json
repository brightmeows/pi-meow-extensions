{
  "name": "@brightmeows/pi-aliases",
  "version": "0.0.0",
  "description": "斜杠命令别名（/clear 到 /new、/exit 到 /quit）",
  "keywords": [
    "cmd",
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brightmeows/pi-meow-extensions.git",
    "directory": "packages/aliases"
  },
  "files": [
    "**/*.ts",
    "!**/*.test.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
