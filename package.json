{
  "name": "pi-meow-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "brightmeows 的 pi coding agent 扩展集合，14 个独立 npm 包",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-pi-version.mjs && tsc --noEmit",
    "check:pi": "node scripts/check-pi-version.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "chmod +x .githooks/pre-commit && git config core.hooksPath .githooks",
    "test": "node --test packages/ask-user-question packages/git-attribution"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
